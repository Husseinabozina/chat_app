{
  "name": "chat-platform-api",
  "version": "0.1.0",
  "private": true,
  "description": "Backend API and realtime gateway for the messaging platform",
  "license": "UNLICENSED",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"*.{json,cjs,mjs}\" \".prettierrc.json\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"*.{json,cjs,mjs}\" \".prettierrc.json\"",
    "lint": "eslint src test",
    "lint:fix": "eslint src test --fix",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "test": "npm run typecheck:test && node --import tsx --test --test-isolation=none test/health.e2e.test.ts && node --import tsx --test --test-isolation=none test/auth.e2e.test.ts && node --import tsx --test --test-isolation=none test/users.e2e.test.ts && node --import tsx --test --test-isolation=none test/messaging.e2e.test.ts && node --import tsx --test --test-isolation=none test/realtime.e2e.test.ts",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "db:migrate": "npm run build && node dist/database/migrate.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1145.0",
    "@aws-sdk/s3-presigned-post": "3.1145.0",
    "@aws-sdk/s3-request-presigner": "3.1145.0",
    "@nestjs/common": "12.1.1",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.1",
    "@nestjs/jwt": "12.0.2",
    "@nestjs/platform-express": "12.1.1",
    "@nestjs/platform-socket.io": "12.1.1",
    "@nestjs/typeorm": "12.0.2",
    "@nestjs/websockets": "12.1.1",
    "@socket.io/redis-adapter": "8.3.0",
    "@vercel/blob": "2.8.1",
    "@vercel/functions": "3.9.11",
    "argon2": "0.45.1",
    "class-transformer": "0.5.1",
    "class-validator": "^0.14.2",
    "firebase-admin": "14.5.0",
    "ioredis": "5.11.1",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5",
    "socket.io": "4.8.1",
    "typeorm": "1.1.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "12.0.8",
    "@types/node": "^24.0.0",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "16.4.0",
    "prettier": "3.9.9",
    "socket.io-client": "4.8.1",
    "tsx": "4.23.15",
    "typescript": "^6.0.0",
    "typescript-eslint": "8.71.0"
  },
  "allowScripts": {
    "argon2@0.45.1": true,
    "esbuild@0.28.2": true
  }
}
