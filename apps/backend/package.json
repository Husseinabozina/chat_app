{
  "name": "chat-platform-api",
  "version": "0.1.0",
  "private": true,
  "description": "Backend API and realtime gateway for the messaging platform",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"*.{json,cjs,mjs}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"*.{json,cjs,mjs}\"",
    "lint": "eslint src test",
    "lint:fix": "eslint src test --fix",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "test": "jest --runInBand",
    "test:cov": "jest --runInBand --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@nestjs/common": "12.1.1",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.1",
    "@nestjs/platform-express": "12.1.1",
    "@nestjs/typeorm": "12.0.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "1.1.1"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.8",
    "@nestjs/testing": "12.1.1",
    "@types/jest": "30.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "7.2.1",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "16.4.0",
    "jest": "30.5.2",
    "prettier": "3.9.0",
    "supertest": "7.3.0",
    "ts-jest": "29.4.14",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "@eslint/js": "10.10.0"
  }
}
