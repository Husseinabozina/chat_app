PORT=3000
DATABASE_URL=postgresql://chat_app:chat_app@localhost:5432/chat_app_dev
ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
REALTIME_TYPING_TTL_MS=7000

# Optional for text-only work; required for profile/image media. Private bucket.
MEDIA_BUCKET=
MEDIA_REGION=us-east-1
MEDIA_ENDPOINT=
MEDIA_PUBLIC_ENDPOINT=
MEDIA_PATH_STYLE=false
MEDIA_ACCESS_KEY=
MEDIA_SECRET_KEY=
# Local MinIO example: endpoint http://127.0.0.1:9000, path style true.
# For devices/emulators, the signing endpoint must be reachable from the client.

# Explicit push opt-in; credentials supplied through ADC/GOOGLE_APPLICATION_CREDENTIALS, never committed.
PUSH_ENABLED=false
FCM_PROJECT_ID=
